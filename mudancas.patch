diff --git a/ProjetoBiblioteca/Dockerfile b/ProjetoBiblioteca/Dockerfile
new file mode 100644
index 0000000..be6d057
--- /dev/null
+++ b/ProjetoBiblioteca/Dockerfile
@@ -0,0 +1,21 @@
+# ---------- Etapa 1: build ----------
+FROM eclipse-temurin:25-jdk AS build
+WORKDIR /app
+
+# Copia só o necessário para baixar as dependências (aproveita o cache do Docker)
+COPY .mvn .mvn
+COPY mvnw pom.xml ./
+RUN chmod +x mvnw && ./mvnw -q dependency:go-offline
+
+# Copia o código e gera o .jar
+COPY src src
+RUN ./mvnw -q package -DskipTests
+
+# ---------- Etapa 2: execução ----------
+FROM eclipse-temurin:25-jre
+WORKDIR /app
+
+COPY --from=build /app/target/*.jar app.jar
+
+EXPOSE 8080
+ENTRYPOINT ["java", "-jar", "app.jar"]
