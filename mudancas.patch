new file mode 100644
index 0000000..f7b688f
--- /dev/null
+++ b/docker-compose.yml
@@ -0,0 +1,35 @@
+services:
+  db:
+    image: postgres:16
+    container_name: biblioteca-db
+    environment:
+      POSTGRES_DB: biblioteca
+      POSTGRES_USER: postgres
+      POSTGRES_PASSWORD: postgres
+    ports:
+      # Se a porta 5432 já estiver em uso (PostgreSQL instalado no Windows),
+      # use outra: DB_PORT=5433 docker compose up -d db
+      - "${DB_PORT:-5432}:5432"
+    volumes:
+      - biblioteca-data:/var/lib/postgresql/data
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U postgres -d biblioteca"]
+      interval: 5s
+      timeout: 5s
+      retries: 10
+
+  app:
+    build: ./ProjetoBiblioteca
+    container_name: biblioteca-app
+    depends_on:
+      db:
+        condition: service_healthy
+    environment:
+      SPRING_DATASOURCE_URL: jdbc:postgresql://db:5432/biblioteca
+      SPRING_DATASOURCE_USERNAME: postgres
+      SPRING_DATASOURCE_PASSWORD: postgres
+    ports:
+      - "8080:8080"
+
+volumes:
+  biblioteca-data:
