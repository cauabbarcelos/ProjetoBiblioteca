+        Map<Usuario, BigDecimal> totalPorUsuario = emprestimoRepository.findAll().stream()
+                .collect(Collectors.groupingBy(
+                        Emprestimo::getUsuario,
+                        Collectors.reducing(
+                                BigDecimal.ZERO,
+                                e -> e.getMulta() == null ? BigDecimal.ZERO : e.getMulta(),
+                                BigDecimal::add)));
+
+        return totalPorUsuario.entrySet().stream()
+                .filter(e -> e.getValue().compareTo(BigDecimal.ZERO) > 0)
+                .sorted(Map.Entry.<Usuario, BigDecimal>comparingByValue().reversed())
+                .map(e -> new MultaPorUsuarioResponse(
+                        e.getKey().getId(),
+                        e.getKey().getNome(),
+                        e.getValue()))
+                .toList();
+    }
+
+    // Livros agrupados por categoria (em ordem alfabética)
+    @Transactional(readOnly = true)
+    public List<LivrosPorCategoriaResponse> livrosPorCategoria() {
+        Map<String, List<String>> titulosPorCategoria = livroRepository.findAll().stream()
+                .flatMap(livro -> livro.getCategorias().stream()
+                        .map(categoria -> Map.entry(categoria.getNome(), livro.getTitulo())))
+                .collect(Collectors.groupingBy(
+                        Map.Entry::getKey,
+                        TreeMap::new,
+                        Collectors.mapping(Map.Entry::getValue, Collectors.toList())));
+
+        return titulosPorCategoria.entrySet().stream()
+                .map(e -> new LivrosPorCategoriaResponse(
+                        e.getKey(),
+                        e.getValue().stream().sorted().toList()))
+                .toList();
+    }
 }
